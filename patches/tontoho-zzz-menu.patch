+// MARK: tontoho Mode — main menu: Mod Settings, Plugins, Customization, Network.
+import SGItemListUI
+import SGStrings
+
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private enum TontohoMenuSection: Int32, SGItemListSection {
+    case main
+}
+
+private enum TontohoMenuLink: String {
+    case settings
+    case plugins
+    case customization
+    case network
+}
+
+private typealias TontohoMenuEntry = SGItemListUIEntry<TontohoMenuSection, AnyHashable, AnyHashable, AnyHashable, TontohoMenuLink, AnyHashable>
+
+private func tontohoMenuEntries(presentationData: PresentationData) -> [TontohoMenuEntry] {
+    let lang = presentationData.strings.baseLanguageCode
+    let id = SGItemListCounter()
+    var entries: [TontohoMenuEntry] = []
+    entries.append(.disclosure(id: id.count, section: .main, link: .settings, text: "👻  " + i18n("TontohoMode.Settings", lang)))
+    entries.append(.disclosure(id: id.count, section: .main, link: .plugins, text: "🧩  " + i18n("TontohoMode.Plugins", lang)))
+    entries.append(.disclosure(id: id.count, section: .main, link: .customization, text: "🎨  " + i18n("TontohoMode.Customization", lang)))
+    entries.append(.disclosure(id: id.count, section: .main, link: .network, text: "🌐  " + i18n("TontohoMode.Network", lang)))
+    entries.append(.notice(id: id.count, section: .main, text: i18n("TontohoMode.Menu.Notice", lang)))
+    return entries
+}
+
+public func sgTontohoModeController(context: AccountContext) -> ViewController {
+    var pushControllerImpl: ((ViewController) -> Void)?
+
+    let arguments = SGItemListArguments<AnyHashable, AnyHashable, AnyHashable, TontohoMenuLink, AnyHashable>(
+        context: context,
+        openDisclosureLink: { link in
+            switch link {
+            case .settings:
+                pushControllerImpl?(sgTontohoModeSettingsController(context: context))
+            case .plugins:
+                pushControllerImpl?(sgTontohoPluginsController(context: context))
+            case .customization:
+                pushControllerImpl?(sgTontohoCustomizationController(context: context))
+            case .network:
+                pushControllerImpl?(sgTontohoNetworkController(context: context))
+            }
+        }
+    )
+
+    let signal = context.sharedContext.presentationData
+    |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = tontohoMenuEntries(presentationData: presentationData)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("tontoho Mode"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    pushControllerImpl = { [weak controller] c in
+        (controller?.navigationController as? NavigationController)?.pushViewController(c)
+    }
+    return controller
+}
