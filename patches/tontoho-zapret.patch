diff --git a/submodules/MtProtoKit/Sources/MTTcpConnection.m b/submodules/MtProtoKit/Sources/MTTcpConnection.m
index f2bdb9dd38..06d9de2414 100644
--- a/submodules/MtProtoKit/Sources/MTTcpConnection.m
+++ b/submodules/MtProtoKit/Sources/MTTcpConnection.m
@@ -710,6 +710,11 @@ struct ctr_state {
 @interface MTGcdAsyncSocketTcpConnectionInterface: NSObject<MTTcpConnectionInterface, GCDAsyncSocketDelegate> {
     GCDAsyncSocket *_socket;
     __weak id<MTTcpConnectionInterfaceDelegate> _delegate;
+    // MARK: tontoho Mode — experimental anti-DPI: send the start of a connection in small TCP segments.
+    dispatch_queue_t _delegateQueue;
+    bool _antiDpiFirstWriteHandled;
+    bool _antiDpiHolding;
+    NSMutableArray<NSData *> *_antiDpiDeferred;
 }
 
 @end
@@ -720,6 +725,8 @@ struct ctr_state {
     self = [super init];
     if (self != nil) {
         _delegate = delegate;
+        _delegateQueue = delegateQueue;
+        _antiDpiDeferred = [[NSMutableArray alloc] init];
         _socket = [[GCDAsyncSocket alloc] initWithDelegate:self delegateQueue:delegateQueue];
     }
     return self;
@@ -742,14 +749,98 @@ struct ctr_state {
 }
 
 - (void)writeData:(NSData *)data {
+    if (_antiDpiHolding) {
+        [_antiDpiDeferred addObject:data];
+        return;
+    }
+    if (!_antiDpiFirstWriteHandled) {
+        _antiDpiFirstWriteHandled = true;
+        NSMutableArray<NSData *> *chunks = [MTGcdAsyncSocketTcpConnectionInterface antiDpiChunksForFirstData:data];
+        if (chunks.count > 1) {
+            NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+            NSInteger delayMs = [defaults objectForKey:@"tontohoAntiDpiDelay"] == nil ? 10 : [defaults integerForKey:@"tontohoAntiDpiDelay"];
+            if (delayMs < 0) {
+                delayMs = 0;
+            }
+            if (delayMs > 500) {
+                delayMs = 500;
+            }
+            if (MTLogEnabled()) {
+                MTLog(@"[tontoho anti-DPI: first write of %d bytes sent as %d parts, delay %d ms]", (int)data.length, (int)chunks.count, (int)delayMs);
+            }
+            _antiDpiHolding = true;
+            [self antiDpiWriteChunks:chunks delayMs:delayMs];
+            return;
+        }
+    }
     [_socket writeData:data withTimeout:-1.0 tag:0];
 }
 
++ (NSMutableArray<NSData *> *)antiDpiChunksForFirstData:(NSData *)data {
+    NSMutableArray<NSData *> *chunks = [[NSMutableArray alloc] init];
+    NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+    if (![defaults boolForKey:@"tontohoAntiDpi"] || data.length < 4) {
+        [chunks addObject:data];
+        return chunks;
+    }
+    NSString *mode = [defaults stringForKey:@"tontohoAntiDpiMode"];
+    if ([mode isEqualToString:@"multi"]) {
+        // The first 64 bytes (the obfuscation header) in 4-byte pieces, then the rest.
+        NSUInteger headerLength = MIN((NSUInteger)64, data.length);
+        NSUInteger offset = 0;
+        while (offset < headerLength) {
+            NSUInteger partLength = MIN((NSUInteger)4, headerLength - offset);
+            [chunks addObject:[data subdataWithRange:NSMakeRange(offset, partLength)]];
+            offset += partLength;
+        }
+        if (offset < data.length) {
+            [chunks addObject:[data subdataWithRange:NSMakeRange(offset, data.length - offset)]];
+        }
+    } else {
+        NSUInteger splitPosition = 1;
+        if ([mode isEqualToString:@"split2"]) {
+            splitPosition = 2;
+        } else if ([mode isEqualToString:@"split32"]) {
+            splitPosition = 32;
+        }
+        if (splitPosition >= data.length) {
+            splitPosition = 1;
+        }
+        [chunks addObject:[data subdataWithRange:NSMakeRange(0, splitPosition)]];
+        [chunks addObject:[data subdataWithRange:NSMakeRange(splitPosition, data.length - splitPosition)]];
+    }
+    return chunks;
+}
+
+- (void)antiDpiWriteChunks:(NSMutableArray<NSData *> *)chunks delayMs:(NSInteger)delayMs {
+    if (chunks.count == 0) {
+        _antiDpiHolding = false;
+        for (NSData *deferred in _antiDpiDeferred) {
+            [_socket writeData:deferred withTimeout:-1.0 tag:0];
+        }
+        [_antiDpiDeferred removeAllObjects];
+        return;
+    }
+    NSData *chunk = chunks.firstObject;
+    [chunks removeObjectAtIndex:0];
+    [_socket writeData:chunk withTimeout:-1.0 tag:0];
+
+    __weak MTGcdAsyncSocketTcpConnectionInterface *weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)delayMs * (int64_t)NSEC_PER_MSEC), _delegateQueue, ^{
+        __strong MTGcdAsyncSocketTcpConnectionInterface *strongSelf = weakSelf;
+        if (strongSelf != nil) {
+            [strongSelf antiDpiWriteChunks:chunks delayMs:delayMs];
+        }
+    });
+}
+
 - (void)readDataToLength:(NSUInteger)length withTimeout:(NSTimeInterval)timeout tag:(long)tag {
     [_socket readDataToLength:length withTimeout:timeout tag:tag];
 }
 
 - (void)disconnect {
+    _antiDpiHolding = false;
+    [_antiDpiDeferred removeAllObjects];
     [_socket disconnect];
 }
 
