diff --git a/Swiftgram/SGSettingsUI/Sources/TontohoNetworkController.swift b/Swiftgram/SGSettingsUI/Sources/TontohoNetworkController.swift
new file mode 100644
index 0000000000..ee13952310
--- /dev/null
+++ b/Swiftgram/SGSettingsUI/Sources/TontohoNetworkController.swift
@@ -0,0 +1,137 @@
+// MARK: tontoho Mode — experimental anti-DPI settings (read by MTProtoKit's MTTcpConnection).
+import SGItemListUI
+import SGStrings
+
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private let antiDpiEnabledKey = "tontohoAntiDpi"
+private let antiDpiModeKey = "tontohoAntiDpiMode"
+private let antiDpiDelayKey = "tontohoAntiDpiDelay"
+
+private let antiDpiModes: [String] = ["split1", "split2", "split32", "multi"]
+private let antiDpiDelays: [Int] = [0, 10, 50, 100, 250]
+
+private enum TontohoNetworkSection: Int32, SGItemListSection {
+    case antiDpi
+    case options
+}
+
+private enum TontohoNetworkToggle: String {
+    case antiDpi
+}
+
+private enum TontohoNetworkSelector: String {
+    case mode
+    case delay
+}
+
+private typealias TontohoNetworkEntry = SGItemListUIEntry<TontohoNetworkSection, TontohoNetworkToggle, AnyHashable, TontohoNetworkSelector, AnyHashable, AnyHashable>
+
+private func currentMode() -> String {
+    let value = UserDefaults.standard.string(forKey: antiDpiModeKey) ?? "split1"
+    return antiDpiModes.contains(value) ? value : "split1"
+}
+
+private func currentDelay() -> Int {
+    if UserDefaults.standard.object(forKey: antiDpiDelayKey) == nil {
+        return 10
+    }
+    return UserDefaults.standard.integer(forKey: antiDpiDelayKey)
+}
+
+private func modeTitle(_ mode: String, _ lang: String) -> String {
+    return i18n("Network.AntiDpi.Mode.\(mode)", lang)
+}
+
+private func delayTitle(_ delay: Int, _ lang: String) -> String {
+    return "\(delay) \(i18n("Network.AntiDpi.Ms", lang))"
+}
+
+private func tontohoNetworkEntries(presentationData: PresentationData) -> [TontohoNetworkEntry] {
+    let lang = presentationData.strings.baseLanguageCode
+    let id = SGItemListCounter()
+    let enabled = UserDefaults.standard.bool(forKey: antiDpiEnabledKey)
+    var entries: [TontohoNetworkEntry] = []
+
+    entries.append(.header(id: id.count, section: .antiDpi, text: i18n("Network.AntiDpi.Header", lang), badge: nil))
+    entries.append(.toggle(id: id.count, section: .antiDpi, settingName: .antiDpi, value: enabled, text: i18n("Network.AntiDpi", lang), enabled: true))
+    entries.append(.notice(id: id.count, section: .antiDpi, text: i18n("Network.AntiDpi.Notice", lang)))
+
+    entries.append(.oneFromManySelector(id: id.count, section: .options, settingName: .mode, text: i18n("Network.AntiDpi.Mode", lang), value: modeTitle(currentMode(), lang), enabled: enabled))
+    entries.append(.oneFromManySelector(id: id.count, section: .options, settingName: .delay, text: i18n("Network.AntiDpi.Delay", lang), value: delayTitle(currentDelay(), lang), enabled: enabled))
+    entries.append(.notice(id: id.count, section: .options, text: i18n("Network.AntiDpi.Options.Notice", lang)))
+
+    return entries
+}
+
+public func sgTontohoNetworkController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise(true, ignoreRepeated: false)
+    var presentControllerImpl: ((ViewController, ViewControllerPresentationArguments?) -> Void)?
+
+    let arguments = SGItemListArguments<TontohoNetworkToggle, AnyHashable, TontohoNetworkSelector, AnyHashable, AnyHashable>(
+        context: context,
+        setBoolValue: { setting, value in
+            switch setting {
+            case .antiDpi:
+                UserDefaults.standard.set(value, forKey: antiDpiEnabledKey)
+            }
+            refresh.set(true)
+        },
+        setOneFromManyValue: { setting in
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            let lang = presentationData.strings.baseLanguageCode
+            let actionSheet = ActionSheetController(presentationData: presentationData)
+            var items: [ActionSheetItem] = []
+            switch setting {
+            case .mode:
+                let selected = currentMode()
+                for mode in antiDpiModes {
+                    let title = (mode == selected ? "✓ " : "") + modeTitle(mode, lang)
+                    items.append(ActionSheetButtonItem(title: title, color: .accent, action: { [weak actionSheet] in
+                        actionSheet?.dismissAnimated()
+                        UserDefaults.standard.set(mode, forKey: antiDpiModeKey)
+                        refresh.set(true)
+                    }))
+                }
+            case .delay:
+                let selected = currentDelay()
+                for delay in antiDpiDelays {
+                    let title = (delay == selected ? "✓ " : "") + delayTitle(delay, lang)
+                    items.append(ActionSheetButtonItem(title: title, color: .accent, action: { [weak actionSheet] in
+                        actionSheet?.dismissAnimated()
+                        UserDefaults.standard.set(delay, forKey: antiDpiDelayKey)
+                        refresh.set(true)
+                    }))
+                }
+            }
+            actionSheet.setItemGroups([ActionSheetItemGroup(items: items), ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])])
+            presentControllerImpl?(actionSheet, ViewControllerPresentationArguments(presentationAnimation: .modalSheet))
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(), refresh.get(), context.sharedContext.presentationData)
+    |> map { _, presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = tontohoNetworkEntries(presentationData: presentationData)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(i18n("TontohoMode.Network", presentationData.strings.baseLanguageCode)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentControllerImpl = { [weak controller] c, a in
+        controller?.present(c, in: .window(.root), with: a)
+    }
+    return controller
+}
