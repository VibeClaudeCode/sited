+// MARK: tontoho Mode — example plugins that can be installed from settings.
+import Foundation
+
+public enum SGPluginExamples {
+    public static let all: [String] = [textTools, calculator, layoutFixer, templates, messageInfo, boldAll]
+
+    static let textTools = #"""
+// @id text-tools
+// @name Text Tools
+// @version 1.0
+// @author tontoho
+// @description .up .low .rev .mock .wide — transform the text you send. Message menu: Reverse text.
+
+function mock(s) {
+  var out = "";
+  var upper = false;
+  for (var i = 0; i < s.length; i++) {
+    var c = s[i];
+    if (c.toLowerCase() !== c.toUpperCase()) {
+      out += upper ? c.toUpperCase() : c.toLowerCase();
+      upper = !upper;
+    } else {
+      out += c;
+    }
+  }
+  return out;
+}
+
+tg.addCommand("up", function (args) { return args.toUpperCase(); });
+tg.addCommand("low", function (args) { return args.toLowerCase(); });
+tg.addCommand("rev", function (args) { return Array.from(args).reverse().join(""); });
+tg.addCommand("mock", function (args) { return mock(args); });
+tg.addCommand("wide", function (args) { return Array.from(args).join(" "); });
+
+tg.addMessageAction("Reverse text", function (message) {
+  return Array.from(message.text).reverse().join("");
+});
+"""#
+
+    static let calculator = #"""
+// @id calculator
+// @name Calculator
+// @version 1.0
+// @author tontoho
+// @description .calc 2+2*3 sends "2+2*3 = 8". Supports + - * / % ^ and parentheses.
+
+tg.addCommand("calc", function (args) {
+  var expr = args.trim();
+  if (!/^[0-9+\-*/%^().,\s]+$/.test(expr)) {
+    tg.alert("Only numbers and + - * / % ^ ( ) are allowed.", "Calculator");
+    return null;
+  }
+  try {
+    var js = expr.replace(/,/g, ".").replace(/\^/g, "**");
+    var value = Function('"use strict"; return (' + js + ');')();
+    if (typeof value !== "number" || !isFinite(value)) {
+      tg.alert("Can't calculate this.", "Calculator");
+      return null;
+    }
+    var rounded = Math.round(value * 1e10) / 1e10;
+    return expr + " = " + rounded;
+  } catch (e) {
+    tg.alert("Error: " + e, "Calculator");
+    return null;
+  }
+});
+"""#
+
+    static let layoutFixer = #"""
+// @id layout-fixer
+// @name Keyboard Layout Fixer
+// @version 1.0
+// @author tontoho
+// @description Fixes text typed in the wrong layout (ghbdtn → привет). Command: .fix text. Message menu: Fix layout.
+
+var en = "`qwertyuiop[]asdfghjkl;'zxcvbnm,./~QWERTYUIOP{}ASDFGHJKL:\"ZXCVBNM<>?";
+var ru = "ёйцукенгшщзхъфывапролджэячсмитьбю.ЁЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,";
+
+function convert(text) {
+  var latin = 0, cyrillic = 0;
+  for (var i = 0; i < text.length; i++) {
+    if (/[a-zA-Z]/.test(text[i])) latin++;
+    else if (/[а-яА-ЯёЁ]/.test(text[i])) cyrillic++;
+  }
+  var from = latin >= cyrillic ? en : ru;
+  var to = latin >= cyrillic ? ru : en;
+  var out = "";
+  for (var j = 0; j < text.length; j++) {
+    var index = from.indexOf(text[j]);
+    out += index >= 0 ? to[index] : text[j];
+  }
+  return out;
+}
+
+tg.addCommand("fix", function (args) { return convert(args); });
+tg.addMessageAction("Fix layout", function (message) { return convert(message.text); });
+"""#
+
+    static let templates = #"""
+// @id templates
+// @name Templates
+// @version 1.0
+// @author tontoho
+// @description .tset name text — save a template; .t name — send it; .tdel name — delete; .tlist — show all.
+
+function load() {
+  try { return JSON.parse(tg.storage.get("templates") || "{}"); } catch (e) { return {}; }
+}
+function save(t) { tg.storage.set("templates", JSON.stringify(t)); }
+
+tg.addCommand("tset", function (args) {
+  var m = args.match(/^(\S+)\s+([\s\S]+)$/);
+  if (!m) { tg.alert("Usage: .tset name text", "Templates"); return null; }
+  var t = load();
+  t[m[1].toLowerCase()] = m[2];
+  save(t);
+  tg.alert("Saved template \"" + m[1] + "\"", "Templates");
+  return null;
+});
+
+tg.addCommand("t", function (args) {
+  var t = load();
+  var key = args.trim().toLowerCase();
+  if (!(key in t)) { tg.alert("No template \"" + key + "\". Use .tlist", "Templates"); return null; }
+  return t[key];
+});
+
+tg.addCommand("tdel", function (args) {
+  var t = load();
+  delete t[args.trim().toLowerCase()];
+  save(t);
+  return null;
+});
+
+tg.addCommand("tlist", function () {
+  var t = load();
+  var keys = Object.keys(t);
+  tg.alert(keys.length ? keys.map(function (k) { return k + ": " + t[k]; }).join("\n\n") : "No templates yet.", "Templates");
+  return null;
+});
+"""#
+
+    static let messageInfo = #"""
+// @id message-info
+// @name Message Info
+// @version 1.0
+// @author tontoho
+// @description Message menu: Message info — id, chat id, date, characters and words.
+
+tg.addMessageAction("Message info", function (message) {
+  var date = new Date(message.date * 1000);
+  var words = message.text.trim() ? message.text.trim().split(/\s+/).length : 0;
+  return [
+    "Message ID: " + message.id,
+    "Chat ID: " + message.chatId,
+    "Date: " + date.toLocaleString(),
+    "Outgoing: " + (message.outgoing ? "yes" : "no"),
+    "Characters: " + Array.from(message.text).length,
+    "Words: " + words
+  ].join("\n");
+});
+"""#
+
+    static let boldAll = #"""
+// @id bold-all
+// @name Bold Messages
+// @version 1.0
+// @author tontoho
+// @description Makes every message you send bold. Turn the plugin off to send normal text again.
+
+tg.onOutgoingMessage(function (text) {
+  return tg.formatAll(text, "bold");
+});
+"""#
+}
