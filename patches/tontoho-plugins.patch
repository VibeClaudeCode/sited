+// MARK: tontoho Mode — JavaScript plugin hooks.
+import Foundation
+import UIKit
+import Display
+import TelegramCore
+import TelegramPresentationData
+import AccountContext
+import ContextUI
+import SGPlugins
+
+/// Lets plugins rewrite or cancel outgoing text messages (and media captions).
+func sgPluginsTransformOutgoing(_ messages: [EnqueueMessage], chatId: Int64) -> [EnqueueMessage] {
+    if !SGPluginManager.shared.hasActivePlugins {
+        return messages
+    }
+    var result: [EnqueueMessage] = []
+    for message in messages {
+        guard case let .message(text, attributes, inlineStickers, mediaReference, threadId, replyToMessageId, replyToStoryId, localGroupingKey, correlationId, bubbleUpEmojiOrStickersets) = message, !text.isEmpty else {
+            result.append(message)
+            continue
+        }
+        let newText: String
+        // Entity ranges refer to the old text; formatting is rebuilt below when needed.
+        var newAttributes = attributes.filter { !($0 is TextEntitiesMessageAttribute) }
+        switch SGPluginManager.shared.processOutgoing(text: text, chatId: chatId) {
+        case .unchanged:
+            result.append(message)
+            continue
+        case let .replaced(replacement):
+            newText = replacement
+        case .cancelled:
+            if mediaReference == nil {
+                // Nothing left to send.
+                continue
+            }
+            newText = ""
+        case let .formatted(formattedText, pluginEntities, textChanged):
+            newText = formattedText
+            var entities: [MessageTextEntity] = []
+            if !textChanged {
+                for attribute in attributes {
+                    if let attribute = attribute as? TextEntitiesMessageAttribute {
+                        entities.append(contentsOf: attribute.entities)
+                    }
+                }
+            }
+            for entity in pluginEntities {
+                if let type = sgPluginEntityType(entity) {
+                    entities.append(MessageTextEntity(range: entity.offset ..< (entity.offset + entity.length), type: type))
+                }
+            }
+            if !entities.isEmpty {
+                newAttributes.append(TextEntitiesMessageAttribute(entities: entities))
+            }
+        }
+        result.append(.message(text: newText, attributes: newAttributes, inlineStickers: inlineStickers, mediaReference: mediaReference, threadId: threadId, replyToMessageId: replyToMessageId, replyToStoryId: replyToStoryId, localGroupingKey: localGroupingKey, correlationId: correlationId, bubbleUpEmojiOrStickersets: bubbleUpEmojiOrStickersets))
+    }
+    return result
+}
+
+private func sgPluginEntityType(_ entity: SGPluginEntity) -> MessageTextEntityType? {
+    switch entity.type {
+    case "bold":
+        return .Bold
+    case "italic":
+        return .Italic
+    case "underline":
+        return .Underline
+    case "strikethrough", "strike":
+        return .Strikethrough
+    case "code":
+        return .Code
+    case "pre":
+        return .Pre(language: entity.url)
+    case "spoiler":
+        return .Spoiler
+    case "quote", "blockquote":
+        return .BlockQuote(isCollapsed: false)
+    case "url", "link", "text_url":
+        if let url = entity.url, !url.isEmpty {
+            return .TextUrl(url: url)
+        }
+        return nil
+    default:
+        return nil
+    }
+}
+
+/// Message context menu items registered by plugins.
+func sgPluginsContextMenuActions(message: EngineRawMessage) -> [ContextMenuItem] {
+    let pluginActions = SGPluginManager.shared.messageActions()
+    if pluginActions.isEmpty {
+        return []
+    }
+    let pluginMessage = SGPluginMessage(id: message.id.id, chatId: message.id.peerId.toInt64(), text: message.text, outgoing: !message.flags.contains(.Incoming), date: message.timestamp)
+    return pluginActions.map { pluginAction -> ContextMenuItem in
+        return .action(ContextMenuActionItem(text: pluginAction.title, icon: { theme in
+            return generateTintedImage(image: UIImage(systemName: "puzzlepiece.extension"), color: theme.actionSheet.primaryTextColor)
+        }, action: { _, f in
+            f(.default)
+            SGPluginManager.shared.performMessageAction(pluginAction, message: pluginMessage)
+        }))
+    }
+}
