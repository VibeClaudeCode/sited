+++ b/Swiftgram/SGPlugins/Sources/SGPluginManager.swift
@@ -0,0 +1,778 @@
+// MARK: tontoho Mode — JavaScript plugins (JavaScriptCore).
+//
+// A plugin is a JavaScript file. Optional metadata goes in the first comment lines:
+//   // @id my-plugin
+//   // @name My Plugin
+//   // @version 1.0
+//   // @author Me
+//   // @description What it does
+//
+// Plugin API (global `tg` object):
+//   tg.onOutgoingMessage(fn)        fn(text, chat) -> string (replace) | null/false (don't send) | undefined (keep)
+//   tg.addCommand(name, fn)         ".name args" in an outgoing message -> fn(args, chat), same return values
+//   tg.addMessageAction(title, fn)  message menu item; fn(message); a returned string is shown with a Copy button
+//   tg.alert(text[, title])         show an alert
+//   tg.copy(text)                   copy to clipboard
+//   tg.openUrl(url)                 open a link
+//   tg.httpGet(url, cb)             cb(error, body) — error is null on success
+//   tg.storage.get(key) / tg.storage.set(key, value) / tg.storage.remove(key)   per-plugin string storage
+//   tg.log(...) / console.log(...)  write to the plugin log (Settings → tontoho Mode → Plugins → Log)
+//   tg.version                      API version string
+//
+// chat    = { chatId: "<id>" }
+// message = { id, chatId: "<id>", text, outgoing, date }
+
+import Foundation
+import UIKit
+import JavaScriptCore
+import UniformTypeIdentifiers
+
+public struct SGPluginInfo: Codable, Equatable {
+    public var id: String
+    public var name: String
+    public var version: String
+    public var author: String
+    public var description: String
+    public var code: String
+    public var enabled: Bool
+}
+
+public struct SGPluginMessage {
+    public let id: Int32
+    public let chatId: Int64
+    public let text: String
+    public let outgoing: Bool
+    public let date: Int32
+
+    public init(id: Int32, chatId: Int64, text: String, outgoing: Bool, date: Int32) {
+        self.id = id
+        self.chatId = chatId
+        self.text = text
+        self.outgoing = outgoing
+        self.date = date
+    }
+}
+
+public struct SGPluginMessageAction {
+    public let pluginId: String
+    public let index: Int
+    public let title: String
+}
+
+/// A formatting range in UTF-16 code units (the same units JavaScript string indexes use).
+public struct SGPluginEntity {
+    public let type: String
+    public let offset: Int
+    public let length: Int
+    public let url: String?
+}
+
+public enum SGPluginOutgoingResult {
+    case unchanged
+    case replaced(String)
+    case cancelled
+    /// `textChanged == false` means the original formatting of the message is kept and `entities` are added to it.
+    case formatted(text: String, entities: [SGPluginEntity], textChanged: Bool)
+}
+
+private enum SGPluginHandlerResult {
+    case unchanged
+    case replaced(String)
+    case formatted(String?, [SGPluginEntity])
+    case cancelled
+}
+
+public enum SGPluginError: Error {
+    case empty
+    case script(String)
+
+    public var text: String {
+        switch self {
+        case .empty:
+            return "The plugin file is empty."
+        case let .script(message):
+            return message
+        }
+    }
+}
+
+private final class SGLoadedPlugin {
+    let info: SGPluginInfo
+    let context: JSContext
+    var outgoingHandlers: [JSValue] = []
+    var commands: [String: JSValue] = [:]
+    var messageActions: [(title: String, handler: JSValue)] = []
+
+    init(info: SGPluginInfo, context: JSContext) {
+        self.info = info
+        self.context = context
+    }
+}
+
+public final class SGPluginManager {
+    public static let shared = SGPluginManager()
+
+    public static let apiVersion = "1.0"
+
+    private let listKey = "sg.tontoho.plugins.list"
+    private let storageKeyPrefix = "sg.tontoho.plugins.storage."
+    private let maxLogLines = 300
+
+    public private(set) var plugins: [SGPluginInfo] = []
+    private var loaded: [String: SGLoadedPlugin] = [:]
+    private var logs: [String: [String]] = [:]
+    private var didStart = false
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: self.listKey), let list = try? JSONDecoder().decode([SGPluginInfo].self, from: data) {
+            self.plugins = list
+        }
+    }
+
+    // MARK: Lifecycle
+
+    private func startIfNeeded() {
+        if self.didStart {
+            return
+        }
+        self.didStart = true
+        for plugin in self.plugins where plugin.enabled {
+            _ = self.load(plugin)
+        }
+    }
+
+    private func save() {
+        if let data = try? JSONEncoder().encode(self.plugins) {
+            UserDefaults.standard.set(data, forKey: self.listKey)
+        }
+    }
+
+    public var hasActivePlugins: Bool {
+        return self.plugins.contains(where: { $0.enabled })
+    }
+
+    @discardableResult
+    public func install(code: String) throws -> SGPluginInfo {
+        let trimmed = code.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty {
+            throw SGPluginError.empty
+        }
+        self.startIfNeeded()
+
+        var info = SGPluginManager.parseMetadata(code: code)
+        if let existing = self.plugins.first(where: { $0.id == info.id }) {
+            info.enabled = existing.enabled
+        }
+
+        self.unload(id: info.id)
+        self.logs[info.id] = []
+        if info.enabled {
+            if let error = self.load(info) {
+                self.unload(id: info.id)
+                throw SGPluginError.script(error)
+            }
+        } else if let error = SGPluginManager.checkSyntax(code: code) {
+            throw SGPluginError.script(error)
+        }
+
+        if let index = self.plugins.firstIndex(where: { $0.id == info.id }) {
+            self.plugins[index] = info
+        } else {
+            self.plugins.append(info)
+        }
+        self.save()
+        return info
+    }
+
+    public func remove(id: String) {
+        self.unload(id: id)
+        self.plugins.removeAll(where: { $0.id == id })
+        self.logs[id] = nil
+        UserDefaults.standard.removeObject(forKey: self.storageKeyPrefix + id)
+        self.save()
+    }
+
+    public func setEnabled(id: String, enabled: Bool) {
+        self.startIfNeeded()
+        guard let index = self.plugins.firstIndex(where: { $0.id == id }) else {
+            return
+        }
+        self.plugins[index].enabled = enabled
+        self.save()
+        self.unload(id: id)
+        if enabled {
+            if let error = self.load(self.plugins[index]) {
+                self.appendLog(id: id, "Load error: \(error)")
+            }
+        }
+    }
+
+    public func log(id: String) -> String {
+        let lines = self.logs[id] ?? []
+        return lines.isEmpty ? "—" : lines.joined(separator: "\n")
+    }
+
+    // MARK: Hooks
+
+    public func processOutgoing(text: String, chatId: Int64) -> SGPluginOutgoingResult {
+        guard Thread.isMainThread else {
+            return .unchanged
+        }
+        self.startIfNeeded()
+        if self.loaded.isEmpty {
+            return .unchanged
+        }
+
+        var current = text
+        var entities: [SGPluginEntity] = []
+        var textChanged = false
+        var cancelled = false
+
+        func apply(_ result: SGPluginHandlerResult) {
+            switch result {
+            case .unchanged:
+                break
+            case let .replaced(newText):
+                if newText != current {
+                    current = newText
+                    textChanged = true
+                    entities = []
+                }
+            case let .formatted(newText, newEntities):
+                if let newText = newText, newText != current {
+                    current = newText
+                    textChanged = true
+                    entities = newEntities
+                } else {
+                    entities.append(contentsOf: newEntities)
+                }
+            case .cancelled:
+                cancelled = true
+            }
+        }
+
+        // ".command args"
+        if current.hasPrefix(".") {
+            let body = String(current.dropFirst())
+            let name: String
+            let args: String
+            if let space = body.firstIndex(where: { $0 == " " || $0 == "\n" }) {
+                name = String(body[body.startIndex ..< space]).lowercased()
+                args = String(body[body.index(after: space)...])
+            } else {
+                name = body.lowercased()
+                args = ""
+            }
+            if !name.isEmpty {
+                for plugin in self.orderedLoaded() {
+                    if let handler = plugin.commands[name] {
+                        let chat = self.chatObject(chatId: chatId, in: plugin.context)
+                        let result = self.call(plugin: plugin, handler: handler, arguments: [args, chat])
+                        apply(self.interpretOutgoing(result))
+                        if cancelled {
+                            return .cancelled
+                        }
+                        break
+                    }
+                }
+            }
+        }
+
+        for plugin in self.orderedLoaded() {
+            for handler in plugin.outgoingHandlers {
+                let chat = self.chatObject(chatId: chatId, in: plugin.context)
+                let result = self.call(plugin: plugin, handler: handler, arguments: [current, chat])
+                apply(self.interpretOutgoing(result))
+                if cancelled {
+                    return .cancelled
+                }
+            }
+        }
+
+        if textChanged && current.isEmpty {
+            return .cancelled
+        }
+        let length = (current as NSString).length
+        let validEntities = entities.compactMap { entity -> SGPluginEntity? in
+            let start = max(0, entity.offset)
+            let end = min(length, entity.offset + entity.length)
+            if end <= start {
+                return nil
+            }
+            return SGPluginEntity(type: entity.type, offset: start, length: end - start, url: entity.url)
+        }
+        if !validEntities.isEmpty {
+            return .formatted(text: current, entities: validEntities, textChanged: textChanged)
+        }
+        if textChanged {
+            return .replaced(current)
+        }
+        return .unchanged
+    }
+
+    public func messageActions() -> [SGPluginMessageAction] {
+        guard Thread.isMainThread else {
+            return []
+        }
+        self.startIfNeeded()
+        var result: [SGPluginMessageAction] = []
+        for plugin in self.orderedLoaded() {
+            for (index, action) in plugin.messageActions.enumerated() {
+                result.append(SGPluginMessageAction(pluginId: plugin.info.id, index: index, title: action.title))
+            }
+        }
+        return result
+    }
+
+    public func performMessageAction(_ action: SGPluginMessageAction, message: SGPluginMessage) {
+        guard let plugin = self.loaded[action.pluginId], action.index < plugin.messageActions.count else {
+            return
+        }
+        let handler = plugin.messageActions[action.index].handler
+        let messageObject: [String: Any] = [
+            "id": NSNumber(value: message.id),
+            "chatId": String(message.chatId),
+            "text": message.text,
+            "outgoing": NSNumber(value: message.outgoing),
+            "date": NSNumber(value: message.date)
+        ]
+        let value = JSValue(object: messageObject, in: plugin.context) as Any
+        let result = self.call(plugin: plugin, handler: handler, arguments: [value])
+        if let result = result, result.isString, let text = result.toString(), !text.isEmpty {
+            SGPluginUI.showResult(title: action.title, text: text)
+        }
+    }
+
+    // MARK: Loading
+
+    private func orderedLoaded() -> [SGLoadedPlugin] {
+        var result: [SGLoadedPlugin] = []
+        for plugin in self.plugins {
+            if let loadedPlugin = self.loaded[plugin.id] {
+                result.append(loadedPlugin)
+            }
+        }
+        return result
+    }
+
+    private func unload(id: String) {
+        self.loaded[id] = nil
+    }
+
+    /// Returns an error description, or nil on success.
+    private func load(_ info: SGPluginInfo) -> String? {
+        guard let context = JSContext() else {
+            return "Could not create a JavaScript context."
+        }
+        context.name = info.name
+        let plugin = SGLoadedPlugin(info: info, context: context)
+        let pluginId = info.id
+
+        context.exceptionHandler = { [weak self] exceptionContext, exception in
+            // A custom handler replaces the default one, which stores the exception; keep that behaviour.
+            exceptionContext?.exception = exception
+            let text = exception?.toString() ?? "unknown error"
+            self?.appendLog(id: pluginId, "Error: \(text)")
+        }
+
+        self.installAPI(plugin: plugin)
+        context.evaluateScript(SGPluginManager.prelude)
+
+        context.exception = nil
+        context.evaluateScript(info.code)
+        if let exception = context.exception {
+            let text = exception.toString() ?? "unknown error"
+            context.exception = nil
+            return text
+        }
+        self.loaded[info.id] = plugin
+        self.appendLog(id: pluginId, "Loaded \(info.name) \(info.version)")
+        return nil
+    }
+
+    private static func checkSyntax(code: String) -> String? {
+        guard let context = JSContext() else {
+            return nil
+        }
+        // Wrapping in a never-called function only parses the code.
+        let wrapped = "(function(){\n" + code + "\n})"
+        context.evaluateScript(wrapped)
+        if let exception = context.exception {
+            return exception.toString()
+        }
+        return nil
+    }
+
+    private func installAPI(plugin: SGLoadedPlugin) {
+        let context = plugin.context
+        let pluginId = plugin.info.id
+        let pluginName = plugin.info.name
+        let storageKey = self.storageKeyPrefix + pluginId
+
+        guard let tg = JSValue(newObjectIn: context), let storage = JSValue(newObjectIn: context), let console = JSValue(newObjectIn: context) else {
+            return
+        }
+
+        let onOutgoingMessage: @convention(block) (JSValue) -> Void = { [weak plugin] handler in
+            guard let plugin = plugin, !handler.isUndefined, !handler.isNull else {
+                return
+            }
+            plugin.outgoingHandlers.append(handler)
+        }
+        let addCommand: @convention(block) (String, JSValue) -> Void = { [weak plugin] name, handler in
+            guard let plugin = plugin, !handler.isUndefined, !handler.isNull else {
+                return
+            }
+            var normalized = name.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+            if normalized.hasPrefix(".") {
+                normalized = String(normalized.dropFirst())
+            }
+            if !normalized.isEmpty {
+                plugin.commands[normalized] = handler
+            }
+        }
+        let addMessageAction: @convention(block) (String, JSValue) -> Void = { [weak plugin] title, handler in
+            guard let plugin = plugin, !handler.isUndefined, !handler.isNull else {
+                return
+            }
+            plugin.messageActions.append((title: title, handler: handler))
+        }
+        let alert: @convention(block) (String, JSValue) -> Void = { text, title in
+            let titleText = (title.isUndefined || title.isNull) ? pluginName : (title.toString() ?? pluginName)
+            SGPluginUI.showAlert(title: titleText, text: text)
+        }
+        let copy: @convention(block) (String) -> Void = { text in
+            DispatchQueue.main.async {
+                UIPasteboard.general.string = text
+            }
+        }
+        let openUrl: @convention(block) (String) -> Void = { string in
+            guard let url = URL(string: string) else {
+                return
+            }
+            DispatchQueue.main.async {
+                UIApplication.shared.open(url, options: [:], completionHandler: nil)
+            }
+        }
+        let httpGet: @convention(block) (String, JSValue) -> Void = { [weak self] string, callback in
+            guard let url = URL(string: string), url.scheme == "https" || url.scheme == "http" else {
+                callback.call(withArguments: ["invalid url", NSNull()])
+                return
+            }
+            URLSession.shared.dataTask(with: url, completionHandler: { data, response, error in
+                var body = ""
+                if let data = data {
+                    body = String(data: data, encoding: .utf8) ?? ""
+                }
+                var errorText: String?
+                if let error = error {
+                    errorText = error.localizedDescription
+                } else if let response = response as? HTTPURLResponse, !(200 ..< 300).contains(response.statusCode) {
+                    errorText = "HTTP \(response.statusCode)"
+                }
+                DispatchQueue.main.async {
+                    guard let self = self, self.loaded[pluginId] != nil else {
+                        return
+                    }
+                    let errorArgument: Any = errorText.map { $0 as Any } ?? NSNull()
+                    callback.call(withArguments: [errorArgument, body])
+                }
+            }).resume()
+        }
+        let storageGet: @convention(block) (String) -> String? = { key in
+            let dict = UserDefaults.standard.dictionary(forKey: storageKey) as? [String: String] ?? [:]
+            return dict[key]
+        }
+        let storageSet: @convention(block) (String, JSValue) -> Void = { key, value in
+            var dict = UserDefaults.standard.dictionary(forKey: storageKey) as? [String: String] ?? [:]
+            if value.isUndefined || value.isNull {
+                dict[key] = nil
+            } else {
+                dict[key] = value.toString() ?? ""
+            }
+            UserDefaults.standard.set(dict, forKey: storageKey)
+        }
+        let storageRemove: @convention(block) (String) -> Void = { key in
+            var dict = UserDefaults.standard.dictionary(forKey: storageKey) as? [String: String] ?? [:]
+            dict[key] = nil
+            UserDefaults.standard.set(dict, forKey: storageKey)
+        }
+        let log: @convention(block) () -> Void = { [weak self] in
+            let args = JSContext.currentArguments() as? [JSValue] ?? []
+            let line = args.map { $0.toString() ?? "" }.joined(separator: " ")
+            self?.appendLog(id: pluginId, line)
+        }
+
+        tg.setObject(unsafeBitCast(onOutgoingMessage, to: AnyObject.self), forKeyedSubscript: "onOutgoingMessage" as NSString)
+        tg.setObject(unsafeBitCast(addCommand, to: AnyObject.self), forKeyedSubscript: "addCommand" as NSString)
+        tg.setObject(unsafeBitCast(addMessageAction, to: AnyObject.self), forKeyedSubscript: "addMessageAction" as NSString)
+        tg.setObject(unsafeBitCast(alert, to: AnyObject.self), forKeyedSubscript: "alert" as NSString)
+        tg.setObject(unsafeBitCast(copy, to: AnyObject.self), forKeyedSubscript: "copy" as NSString)
+        tg.setObject(unsafeBitCast(openUrl, to: AnyObject.self), forKeyedSubscript: "openUrl" as NSString)
+        tg.setObject(unsafeBitCast(httpGet, to: AnyObject.self), forKeyedSubscript: "httpGet" as NSString)
+        tg.setObject(unsafeBitCast(log, to: AnyObject.self), forKeyedSubscript: "log" as NSString)
+        tg.setObject(SGPluginManager.apiVersion, forKeyedSubscript: "version" as NSString)
+
+        storage.setObject(unsafeBitCast(storageGet, to: AnyObject.self), forKeyedSubscript: "get" as NSString)
+        storage.setObject(unsafeBitCast(storageSet, to: AnyObject.self), forKeyedSubscript: "set" as NSString)
+        storage.setObject(unsafeBitCast(storageRemove, to: AnyObject.self), forKeyedSubscript: "remove" as NSString)
+        tg.setObject(storage, forKeyedSubscript: "storage" as NSString)
+
+        console.setObject(unsafeBitCast(log, to: AnyObject.self), forKeyedSubscript: "log" as NSString)
+        console.setObject(unsafeBitCast(log, to: AnyObject.self), forKeyedSubscript: "error" as NSString)
+        console.setObject(unsafeBitCast(log, to: AnyObject.self), forKeyedSubscript: "warn" as NSString)
+
+        context.setObject(tg, forKeyedSubscript: "tg" as NSString)
+        context.setObject(console, forKeyedSubscript: "console" as NSString)
+    }
+
+    // MARK: Helpers
+
+    private func call(plugin: SGLoadedPlugin, handler: JSValue, arguments: [Any]) -> JSValue? {
+        plugin.context.exception = nil
+        let result = handler.call(withArguments: arguments)
+        if plugin.context.exception != nil {
+            plugin.context.exception = nil
+            return nil
+        }
+        return result
+    }
+
+    private func chatObject(chatId: Int64, in context: JSContext) -> Any {
+        let dict: [String: Any] = ["chatId": String(chatId)]
+        return JSValue(object: dict, in: context) as Any
+    }
+
+    private func interpretOutgoing(_ value: JSValue?) -> SGPluginHandlerResult {
+        guard let value = value else {
+            return .unchanged
+        }
+        if value.isUndefined {
+            return .unchanged
+        }
+        if value.isNull {
+            return .cancelled
+        }
+        if value.isBoolean {
+            return value.toBool() ? .unchanged : .cancelled
+        }
+        if value.isObject && !value.isArray && (value.hasProperty("text") || value.hasProperty("entities")) {
+            var text: String?
+            if let textValue = value.forProperty("text"), textValue.isString {
+                text = textValue.toString()
+            }
+            var entities: [SGPluginEntity] = []
+            if let list = value.forProperty("entities"), list.isArray, let items = list.toArray() {
+                for item in items {
+                    guard let dict = item as? [String: Any], let type = dict["type"] as? String else {
+                        continue
+                    }
+                    let offset = (dict["offset"] as? NSNumber)?.intValue ?? 0
+                    let length = (dict["length"] as? NSNumber)?.intValue ?? 0
+                    entities.append(SGPluginEntity(type: type.lowercased(), offset: offset, length: length, url: dict["url"] as? String))
+                }
+            }
+            return .formatted(text, entities)
+        }
+        if let text = value.toString() {
+            return .replaced(text)
+        }
+        return .unchanged
+    }
+
+    private func appendLog(id: String, _ line: String) {
+        let formatter = DateFormatter()
+        formatter.dateFormat = "HH:mm:ss"
+        var lines = self.logs[id] ?? []
+        lines.append("[\(formatter.string(from: Date()))] \(line)")
+        if lines.count > self.maxLogLines {
+            lines.removeFirst(lines.count - self.maxLogLines)
+        }
+        self.logs[id] = lines
+    }
+
+    private static let prelude = """
+    tg.entity = function (type, offset, length, url) {
+      return { type: String(type), offset: offset, length: length, url: url };
+    };
+    tg.formatAll = function (text, type, url) {
+      text = String(text);
+      return { text: text, entities: text.length ? [tg.entity(type, 0, text.length, url)] : [] };
+    };
+    tg.format = function (text, entities) {
+      return { text: String(text), entities: entities || [] };
+    };
+    """
+
+    static func parseMetadata(code: String) -> SGPluginInfo {
+        var meta: [String: String] = [:]
+        for rawLine in code.components(separatedBy: .newlines).prefix(40) {
+            let line = rawLine.trimmingCharacters(in: .whitespaces)
+            guard line.hasPrefix("//") else {
+                if line.isEmpty {
+                    continue
+                }
+                break
+            }
+            let content = line.dropFirst(2).trimmingCharacters(in: .whitespaces)
+            guard content.hasPrefix("@") else {
+                continue
+            }
+            let keyAndValue = content.dropFirst()
+            if let space = keyAndValue.firstIndex(of: " ") {
+                let key = String(keyAndValue[keyAndValue.startIndex ..< space]).lowercased()
+                let value = String(keyAndValue[keyAndValue.index(after: space)...]).trimmingCharacters(in: .whitespaces)
+                meta[key] = value
+            }
+        }
+        let name = meta["name"] ?? "Plugin"
+        var id = meta["id"] ?? ""
+        if id.isEmpty {
+            let allowed = CharacterSet.alphanumerics
+            id = name.lowercased().unicodeScalars.map { allowed.contains($0) ? String($0) : "-" }.joined()
+            if id.isEmpty || id == "plugin" {
+                id = "plugin-\(UInt(bitPattern: code.hashValue))"
+            }
+        }
+        return SGPluginInfo(
+            id: id,
+            name: name,
+            version: meta["version"] ?? "1.0",
+            author: meta["author"] ?? "",
+            description: meta["description"] ?? "",
+            code: code,
+            enabled: true
+        )
+    }
+}
+
+// MARK: UIKit presentation helpers
+
+public enum SGPluginUI {
+    static func topViewController() -> UIViewController? {
+        let windows = UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }
+            .flatMap { $0.windows }
+        let window = windows.first(where: { $0.isKeyWindow }) ?? windows.first
+        var controller = window?.rootViewController
+        while let presented = controller?.presentedViewController, !presented.isBeingDismissed {
+            controller = presented
+        }
+        return controller
+    }
+
+    static func present(_ controller: UIViewController) {
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
+            topViewController()?.present(controller, animated: true, completion: nil)
+        }
+    }
+
+    public static func showAlert(title: String?, text: String, okTitle: String = "OK") {
+        let alert = UIAlertController(title: title, message: text, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: okTitle, style: .default, handler: nil))
+        present(alert)
+    }
+
+    public static func showResult(title: String?, text: String, copyTitle: String = "Copy", okTitle: String = "OK") {
+        let alert = UIAlertController(title: title, message: text, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: copyTitle, style: .default, handler: { _ in
+            UIPasteboard.general.string = text
+        }))
+        alert.addAction(UIAlertAction(title: okTitle, style: .cancel, handler: nil))
+        present(alert)
+    }
+
+    public static func confirm(title: String?, text: String?, confirmTitle: String, cancelTitle: String, destructive: Bool, completion: @escaping () -> Void) {
+        let alert = UIAlertController(title: title, message: text, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: cancelTitle, style: .cancel, handler: nil))
+        alert.addAction(UIAlertAction(title: confirmTitle, style: destructive ? .destructive : .default, handler: { _ in
+            completion()
+        }))
+        present(alert)
+    }
+
+    public static func askText(title: String?, placeholder: String, okTitle: String, cancelTitle: String, completion: @escaping (String) -> Void) {
+        let alert = UIAlertController(title: title, message: nil, preferredStyle: .alert)
+        alert.addTextField { textField in
+            textField.placeholder = placeholder
+            textField.keyboardType = .URL
+            textField.autocapitalizationType = .none
+            textField.autocorrectionType = .no
+        }
+        alert.addAction(UIAlertAction(title: cancelTitle, style: .cancel, handler: nil))
+        alert.addAction(UIAlertAction(title: okTitle, style: .default, handler: { [weak alert] _ in
+            let text = alert?.textFields?.first?.text ?? ""
+            completion(text.trimmingCharacters(in: .whitespacesAndNewlines))
+        }))
+        present(alert)
+    }
+
+    public static func download(urlString: String, completion: @escaping (String?, String?) -> Void) {
+        guard let url = URL(string: urlString), url.scheme == "https" || url.scheme == "http" else {
+            completion(nil, "Invalid URL")
+            return
+        }
+        URLSession.shared.dataTask(with: url, completionHandler: { data, response, error in
+            var text: String?
+            var errorText: String?
+            if let error = error {
+                errorText = error.localizedDescription
+            } else if let response = response as? HTTPURLResponse, !(200 ..< 300).contains(response.statusCode) {
+                errorText = "HTTP \(response.statusCode)"
+            } else if let data = data {
+                text = String(data: data, encoding: .utf8)
+                if text == nil {
+                    errorText = "The file is not UTF-8 text."
+                }
+            }
+            DispatchQueue.main.async {
+                completion(text, errorText)
+            }
+        }).resume()
+    }
+
+    private static var currentPickerDelegate: SGPluginDocumentPickerDelegate?
+
+    public static func pickFile(completion: @escaping (String?, String?) -> Void) {
+        let types: [UTType] = [.javaScript, .plainText, .text, .data]
+        let picker = UIDocumentPickerViewController(forOpeningContentTypes: types, asCopy: true)
+        let delegate = SGPluginDocumentPickerDelegate(completion: { text, error in
+            SGPluginUI.currentPickerDelegate = nil
+            completion(text, error)
+        })
+        SGPluginUI.currentPickerDelegate = delegate
+        picker.delegate = delegate
+        picker.allowsMultipleSelection = false
+        present(picker)
+    }
+}
+
+private final class SGPluginDocumentPickerDelegate: NSObject, UIDocumentPickerDelegate {
+    private let completion: (String?, String?) -> Void
+
+    init(completion: @escaping (String?, String?) -> Void) {
+        self.completion = completion
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard let url = urls.first else {
+            self.completion(nil, nil)
+            return
+        }
+        let accessing = url.startAccessingSecurityScopedResource()
+        defer {
+            if accessing {
+                url.stopAccessingSecurityScopedResource()
+            }
+        }
+        if let data = try? Data(contentsOf: url), let text = String(data: data, encoding: .utf8) {
+            self.completion(text, nil)
+        } else {
+            self.completion(nil, "Could not read the file as UTF-8 text.")
+        }
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        self.completion(nil, nil)
+    }
+}
