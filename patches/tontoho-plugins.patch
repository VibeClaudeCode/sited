@@ -0,0 +1,159 @@
+// MARK: tontoho Mode — JavaScript plugins settings screen.
+import SGItemListUI
+import SGPlugins
+import SGStrings
+
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private struct TontohoPluginsSection: SGItemListSection, Hashable {
+    let rawValue: Int32
+}
+
+private enum TontohoPluginsAction: Hashable {
+    case addFile
+    case addClipboard
+    case addURL
+    case addExamples
+    case showLog(String)
+    case delete(String)
+}
+
+private typealias TontohoPluginsEntry = SGItemListUIEntry<TontohoPluginsSection, String, AnyHashable, AnyHashable, AnyHashable, TontohoPluginsAction>
+
+private func tontohoPluginsEntries(presentationData: PresentationData) -> [TontohoPluginsEntry] {
+    let lang = presentationData.strings.baseLanguageCode
+    let id = SGItemListCounter()
+    var entries: [TontohoPluginsEntry] = []
+
+    let installSection = TontohoPluginsSection(rawValue: 0)
+    entries.append(.header(id: id.count, section: installSection, text: i18n("Plugins.Header.Install", lang), badge: nil))
+    entries.append(.action(id: id.count, section: installSection, actionType: .addFile, text: i18n("Plugins.AddFile", lang), kind: .generic))
+    entries.append(.action(id: id.count, section: installSection, actionType: .addClipboard, text: i18n("Plugins.AddClipboard", lang), kind: .generic))
+    entries.append(.action(id: id.count, section: installSection, actionType: .addURL, text: i18n("Plugins.AddURL", lang), kind: .generic))
+    entries.append(.action(id: id.count, section: installSection, actionType: .addExamples, text: i18n("Plugins.AddExamples", lang), kind: .generic))
+    entries.append(.notice(id: id.count, section: installSection, text: i18n("Plugins.Install.Notice", lang)))
+
+    let plugins = SGPluginManager.shared.plugins
+    if plugins.isEmpty {
+        let emptySection = TontohoPluginsSection(rawValue: 1)
+        entries.append(.header(id: id.count, section: emptySection, text: i18n("Plugins.Header.Installed", lang), badge: nil))
+        entries.append(.notice(id: id.count, section: emptySection, text: i18n("Plugins.Empty", lang)))
+    } else {
+        for (index, plugin) in plugins.enumerated() {
+            let section = TontohoPluginsSection(rawValue: Int32(index + 1))
+            if index == 0 {
+                entries.append(.header(id: id.count, section: section, text: i18n("Plugins.Header.Installed", lang), badge: nil))
+            }
+            entries.append(.toggle(id: id.count, section: section, settingName: plugin.id, value: plugin.enabled, text: "\(plugin.name)  \(plugin.version)", enabled: true))
+            var details: [String] = []
+            if !plugin.description.isEmpty {
+                details.append(plugin.description)
+            }
+            if !plugin.author.isEmpty {
+                details.append("— \(plugin.author)")
+            }
+            if !details.isEmpty {
+                entries.append(.notice(id: id.count, section: section, text: details.joined(separator: " ")))
+            }
+            entries.append(.action(id: id.count, section: section, actionType: .showLog(plugin.id), text: i18n("Plugins.Log", lang), kind: .generic))
+            entries.append(.action(id: id.count, section: section, actionType: .delete(plugin.id), text: i18n("Plugins.Delete", lang), kind: .destructive))
+        }
+    }
+
+    return entries
+}
+
+public func sgTontohoPluginsController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise(true, ignoreRepeated: false)
+
+    let install: (String?, String?) -> Void = { code, error in
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        let lang = presentationData.strings.baseLanguageCode
+        if let error = error {
+            SGPluginUI.showAlert(title: i18n("Plugins.Error", lang), text: error, okTitle: presentationData.strings.Common_OK)
+            return
+        }
+        guard let code = code else {
+            return
+        }
+        do {
+            let info = try SGPluginManager.shared.install(code: code)
+            SGPluginUI.showAlert(title: i18n("Plugins.Installed", lang), text: "\(info.name) \(info.version)", okTitle: presentationData.strings.Common_OK)
+        } catch let error as SGPluginError {
+            SGPluginUI.showAlert(title: i18n("Plugins.Error", lang), text: error.text, okTitle: presentationData.strings.Common_OK)
+        } catch {
+            SGPluginUI.showAlert(title: i18n("Plugins.Error", lang), text: "\(error)", okTitle: presentationData.strings.Common_OK)
+        }
+        refresh.set(true)
+    }
+
+    let arguments = SGItemListArguments<String, AnyHashable, AnyHashable, AnyHashable, TontohoPluginsAction>(
+        context: context,
+        setBoolValue: { pluginId, value in
+            SGPluginManager.shared.setEnabled(id: pluginId, enabled: value)
+            refresh.set(true)
+        },
+        action: { action in
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            let lang = presentationData.strings.baseLanguageCode
+            switch action {
+            case .addFile:
+                SGPluginUI.pickFile(completion: install)
+            case .addClipboard:
+                let text = UIPasteboard.general.string ?? ""
+                install(text, text.isEmpty ? i18n("Plugins.ClipboardEmpty", lang) : nil)
+            case .addURL:
+                SGPluginUI.askText(title: i18n("Plugins.AddURL", lang), placeholder: "https://…", okTitle: presentationData.strings.Common_OK, cancelTitle: presentationData.strings.Common_Cancel, completion: { urlString in
+                    if urlString.isEmpty {
+                        return
+                    }
+                    SGPluginUI.download(urlString: urlString, completion: install)
+                })
+            case .addExamples:
+                var names: [String] = []
+                var errors: [String] = []
+                for code in SGPluginExamples.all {
+                    do {
+                        let info = try SGPluginManager.shared.install(code: code)
+                        names.append(info.name)
+                    } catch let error as SGPluginError {
+                        errors.append(error.text)
+                    } catch {
+                        errors.append("\(error)")
+                    }
+                }
+                let text = (names + errors).joined(separator: "\n")
+                SGPluginUI.showAlert(title: i18n("Plugins.Installed", lang), text: text, okTitle: presentationData.strings.Common_OK)
+                refresh.set(true)
+            case let .showLog(pluginId):
+                let name = SGPluginManager.shared.plugins.first(where: { $0.id == pluginId })?.name
+                SGPluginUI.showResult(title: name, text: SGPluginManager.shared.log(id: pluginId), okTitle: presentationData.strings.Common_OK)
+            case let .delete(pluginId):
+                let name = SGPluginManager.shared.plugins.first(where: { $0.id == pluginId })?.name ?? pluginId
+                SGPluginUI.confirm(title: i18n("Plugins.DeleteConfirm", lang), text: name, confirmTitle: i18n("Plugins.Delete", lang), cancelTitle: presentationData.strings.Common_Cancel, destructive: true, completion: {
+                    SGPluginManager.shared.remove(id: pluginId)
+                    refresh.set(true)
+                })
+            }
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(), refresh.get(), context.sharedContext.presentationData)
+    |> map { _, presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = tontohoPluginsEntries(presentationData: presentationData)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(i18n("TontohoMode.Plugins", presentationData.strings.baseLanguageCode)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    return controller
+}
