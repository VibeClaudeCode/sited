+// MARK: tontoho Mode — Telegram functions for plugins (tg.sendMessage, tg.messages, tg.api).
+
+private final class SGPluginsContextBox {
+    weak var context: AccountContext?
+}
+
+private let sgPluginsContextBox = SGPluginsContextBox()
+
+private func sgPluginPeerDictionary(_ peer: EnginePeer) -> [String: Any] {
+    var type = "user"
+    if case .legacyGroup = peer {
+        type = "group"
+    } else if case .channel = peer {
+        type = "channel"
+    } else if case .secretChat = peer {
+        type = "secret"
+    }
+    var result: [String: Any] = [
+        "id": String(peer.id.toInt64()),
+        "name": peer.debugDisplayTitle,
+        "type": type
+    ]
+    if let username = peer.addressName {
+        result["username"] = username
+    }
+    return result
+}
+
+/// Called by AppDelegate whenever the active account changes.
+func sgPluginsSetContext(_ context: AccountContext?) {
+    sgPluginsContextBox.context = context
+    let host = SGPluginManager.shared.host
+
+    host.sendMessage = { chatId, text, completion in
+        guard let context = sgPluginsContextBox.context else {
+            completion("no account")
+            return
+        }
+        if text.isEmpty {
+            completion("empty text")
+            return
+        }
+        let peerId = EnginePeer.Id(chatId)
+        let _ = (enqueueMessages(account: context.account, peerId: peerId, messages: [.message(text: text, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: [])])
+        |> deliverOnMainQueue).startStandalone(next: { _ in
+            completion(nil)
+        })
+    }
+
+    host.getMessages = { chatId, limit, completion in
+        guard let context = sgPluginsContextBox.context else {
+            completion(nil, "no account")
+            return
+        }
+        let peerId = EnginePeer.Id(chatId)
+        let accountPeerId = context.account.peerId
+        let _ = (context.engine.messages.searchMessages(location: .peer(peerId: peerId, fromId: nil, tags: nil, reactions: nil, threadId: nil, minDate: nil, maxDate: nil), query: "", state: nil, limit: Int32(limit))
+        |> take(1)
+        |> deliverOnMainQueue).startStandalone(next: { resultAndState in
+            let result = resultAndState.0
+            var list: [[String: Any]] = []
+            for message in result.messages.prefix(limit) {
+                var item: [String: Any] = [
+                    "id": NSNumber(value: message.id.id),
+                    "chatId": String(message.id.peerId.toInt64()),
+                    "text": message.text,
+                    "outgoing": NSNumber(value: !message.flags.contains(.Incoming)),
+                    "date": NSNumber(value: message.timestamp)
+                ]
+                if let author = message.author {
+                    item["fromId"] = String(author.id.toInt64())
+                    item["fromMe"] = NSNumber(value: author.id == accountPeerId)
+                }
+                list.append(item)
+            }
+            completion(list, nil)
+        })
+    }
+
+    host.apiCall = { method, params, completion in
+        guard let context = sgPluginsContextBox.context else {
+            completion(nil, "no account")
+            return
+        }
+        switch method {
+        case "getMe":
+            let _ = (context.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: context.account.peerId))
+            |> deliverOnMainQueue).startStandalone(next: { peer in
+                if let peer = peer {
+                    completion(sgPluginPeerDictionary(peer), nil)
+                } else {
+                    completion(nil, "not found")
+                }
+            })
+        case "getChat":
+            var chatId: Int64?
+            if let value = params["chatId"] as? String {
+                chatId = Int64(value)
+            } else if let value = params["chatId"] as? NSNumber {
+                chatId = value.int64Value
+            }
+            guard let chatIdValue = chatId else {
+                completion(nil, "chatId is required")
+                return
+            }
+            let _ = (context.engine.data.get(TelegramEngine.EngineData.Item.Peer.Peer(id: EnginePeer.Id(chatIdValue)))
+            |> deliverOnMainQueue).startStandalone(next: { peer in
+                if let peer = peer {
+                    completion(sgPluginPeerDictionary(peer), nil)
+                } else {
+                    completion(nil, "not found")
+                }
+            })
+        case "resolveUsername":
+            guard var username = params["username"] as? String, !username.isEmpty else {
+                completion(nil, "username is required")
+                return
+            }
+            if username.hasPrefix("@") {
+                username = String(username.dropFirst())
+            }
+            let _ = (context.engine.peers.resolvePeerByName(name: username, referrer: nil)
+            |> deliverOnMainQueue).startStandalone(next: { result in
+                if case let .result(peer) = result {
+                    if let peer = peer {
+                        completion(sgPluginPeerDictionary(peer), nil)
+                    } else {
+                        completion(nil, "not found")
+                    }
+                }
+            })
+        default:
+            completion(nil, "unknown method \(method)")
+        }
+    }
+}
