+// MARK: tontoho Mode — previous versions of an edited message, kept by "Keep Edit History".
+func sgMakeEditHistoryContextMenuAction(context: AccountContext, controllerInteraction: ChatControllerInteraction, chatPresentationInterfaceState: ChatPresentationInterfaceState, message: EngineRawMessage) -> ContextMenuItem? {
+    let versions = message.sgEditHistory
+    if versions.isEmpty {
+        return nil
+    }
+    let strings = chatPresentationInterfaceState.strings
+    let title = i18n("ContextMenu.EditHistory", strings.baseLanguageCode)
+    return .action(ContextMenuActionItem(text: title, icon: { theme in
+        return generateTintedImage(image: UIImage(bundleImageName: "Chat/Context Menu/Edit"), color: theme.actionSheet.primaryTextColor)
+    }, action: { _, f in
+        f(.default)
+
+        let formatter = DateFormatter()
+        formatter.dateStyle = .short
+        formatter.timeStyle = .short
+
+        var blocks: [String] = []
+        for version in versions.reversed() {
+            let date = formatter.string(from: Date(timeIntervalSince1970: TimeInterval(version.date)))
+            blocks.append("\(date)\n\(version.text)")
+        }
+        let alert = textAlertController(context: context, title: title, text: blocks.joined(separator: "\n\n"), actions: [
+            TextAlertAction(type: .defaultAction, title: strings.Common_OK, action: {})
+        ])
+        controllerInteraction.presentController(alert, nil)
+    }))
+}
