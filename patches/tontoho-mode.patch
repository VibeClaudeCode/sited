+// MARK: Swiftgram — "tontoho Mode": ghost mode and spy mode settings on one screen.
+import SGItemListUI
+import SGSimpleSettings
+import SGStrings
+
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private enum TontohoSection: Int32, SGItemListSection {
+    case categories
+    case ghost
+    case spy
+    case bots
+}
+
+private enum TontohoToggle: String {
+    case ghostAll
+    case ghostRead
+    case ghostStories
+    case ghostOnline
+    case ghostTyping
+    case keepDeleted
+    case keepEditHistory
+    case keepInBots
+}
+
+private enum TontohoLink: String {
+    case customization
+}
+
+private typealias TontohoEntry = SGItemListUIEntry<TontohoSection, TontohoToggle, AnyHashable, AnyHashable, TontohoLink, AnyHashable>
+
+private func tontohoGhostOptions() -> [Bool] {
+    let s = SGSimpleSettings.shared
+    return [s.ghostModeRead, s.ghostModeStories, s.ghostModeOnline, s.ghostModeTyping]
+}
+
+private func tontohoEntries(presentationData: PresentationData) -> [TontohoEntry] {
+    let lang = presentationData.strings.baseLanguageCode
+    let s = SGSimpleSettings.shared
+    let id = SGItemListCounter()
+    var entries: [TontohoEntry] = []
+
+    let options = tontohoGhostOptions()
+    let enabledCount = options.filter { $0 }.count
+
+    entries.append(.disclosure(id: id.count, section: .categories, link: .customization, text: i18n("TontohoMode.Customization", lang)))
+
+    entries.append(.header(id: id.count, section: .ghost, text: i18n("Settings.GhostMode.Header", lang), badge: nil))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .ghostAll, value: enabledCount > 0, text: "\(i18n("TontohoMode.Ghost", lang))  \(enabledCount)/\(options.count)", enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .ghostRead, value: s.ghostModeRead, text: i18n("Settings.GhostMode.Read", lang), enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .ghostStories, value: s.ghostModeStories, text: i18n("Settings.GhostMode.Stories", lang), enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .ghostOnline, value: s.ghostModeOnline, text: i18n("Settings.GhostMode.Online", lang), enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .ghostTyping, value: s.ghostModeTyping, text: i18n("Settings.GhostMode.Typing", lang), enabled: true))
+    entries.append(.notice(id: id.count, section: .ghost, text: i18n("Settings.GhostMode.Notice", lang)))
+
+    entries.append(.header(id: id.count, section: .spy, text: i18n("TontohoMode.Spy.Header", lang), badge: nil))
+    entries.append(.toggle(id: id.count, section: .spy, settingName: .keepDeleted, value: s.keepDeletedMessages, text: i18n("Settings.KeepDeleted", lang), enabled: true))
+    entries.append(.toggle(id: id.count, section: .spy, settingName: .keepEditHistory, value: s.keepEditHistory, text: i18n("Settings.KeepEditHistory", lang), enabled: true))
+    entries.append(.notice(id: id.count, section: .spy, text: i18n("Settings.KeepDeleted.Notice", lang)))
+
+    entries.append(.toggle(id: id.count, section: .bots, settingName: .keepInBots, value: s.keepDeletedInBots, text: i18n("Settings.KeepInBots", lang), enabled: s.keepDeletedMessages))
+
+    return entries
+}
+
+public func sgTontohoModeController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise(true, ignoreRepeated: false)
+
+    var pushControllerImpl: ((ViewController) -> Void)?
+
+    let arguments = SGItemListArguments<TontohoToggle, AnyHashable, AnyHashable, TontohoLink, AnyHashable>(
+        context: context,
+        setBoolValue: { setting, value in
+            let s = SGSimpleSettings.shared
+            switch setting {
+            case .ghostAll:
+                s.ghostModeRead = value
+                s.ghostModeStories = value
+                s.ghostModeOnline = value
+                s.ghostModeTyping = value
+            case .ghostRead:
+                s.ghostModeRead = value
+            case .ghostStories:
+                s.ghostModeStories = value
+            case .ghostOnline:
+                s.ghostModeOnline = value
+            case .ghostTyping:
+                s.ghostModeTyping = value
+            case .keepDeleted:
+                s.keepDeletedMessages = value
+            case .keepEditHistory:
+                s.keepEditHistory = value
+            case .keepInBots:
+                s.keepDeletedInBots = value
+            }
+            refresh.set(true)
+        },
+        openDisclosureLink: { link in
+            switch link {
+            case .customization:
+                pushControllerImpl?(sgTontohoCustomizationController(context: context))
+            }
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(), refresh.get(), context.sharedContext.presentationData)
+    |> map { _, presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = tontohoEntries(presentationData: presentationData)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("tontoho Mode"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    pushControllerImpl = { [weak controller] c in
+        (controller?.navigationController as? NavigationController)?.pushViewController(c)
+    }
+    return controller
+}
