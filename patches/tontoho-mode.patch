diff --git a/.github/workflows/ghost-build.yml b/.github/workflows/ghost-build.yml
new file mode 100644
index 00000000..ce99f60e
--- /dev/null
+++ b/.github/workflows/ghost-build.yml
@@ -0,0 +1,91 @@
+name: Build unsigned IPA
+
+# Run manually: Actions -> "Build unsigned IPA" -> Run workflow.
+# Needs two repository secrets (Settings -> Secrets and variables -> Actions):
+#   TG_API_ID   - your api_id from https://my.telegram.org/apps
+#   TG_API_HASH - your api_hash from the same page
+on:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: macos-26
+    timeout-minutes: 360
+
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: recursive
+          fetch-depth: 0
+
+      - name: Check secrets
+        env:
+          TG_API_ID: ${{ secrets.TG_API_ID }}
+          TG_API_HASH: ${{ secrets.TG_API_HASH }}
+        run: |
+          if [ -z "$TG_API_ID" ] || [ -z "$TG_API_HASH" ]; then
+            echo "::error::Add TG_API_ID and TG_API_HASH in Settings -> Secrets and variables -> Actions"
+            exit 1
+          fi
+
+      - name: Select Xcode
+        run: |
+          WANT=$(python3 -c 'import json;print(json.load(open("versions.json"))["xcode"])')
+          echo "Wanted Xcode $WANT; installed:"; ls -d /Applications/Xcode*.app
+          if [ -d "/Applications/Xcode_$WANT.app" ]; then
+            sudo xcode-select -s "/Applications/Xcode_$WANT.app/Contents/Developer"
+          else
+            NEWEST=$(ls -d /Applications/Xcode_*.app | sort -V | tail -1)
+            echo "::warning::Xcode $WANT not on runner, using $NEWEST"
+            sudo xcode-select -s "$NEWEST/Contents/Developer"
+          fi
+          xcodebuild -version
+          df -h /
+
+      - name: Free disk space
+        run: |
+          sudo rm -rf /Users/runner/Library/Android /usr/local/share/dotnet /usr/local/lib/node_modules || true
+          df -h /
+
+      - name: Create canonical source directory
+        run: |
+          sudo mkdir -p /Users/Shared
+          sudo chown "$USER" /Users/Shared
+          cp -R "$GITHUB_WORKSPACE" /Users/Shared/telegram-ios
+
+      - name: Write build configuration
+        env:
+          TG_API_ID: ${{ secrets.TG_API_ID }}
+          TG_API_HASH: ${{ secrets.TG_API_HASH }}
+        run: |
+          cd /Users/Shared/telegram-ios
+          python3 - <<'EOF'
+          import json, os
+          c = json.load(open("build-system/appstore-configuration.json"))
+          c["api_id"] = os.environ["TG_API_ID"]
+          c["api_hash"] = os.environ["TG_API_HASH"]
+          json.dump(c, open("build-system/ci-configuration.json", "w"), indent=2)
+          EOF
+
+      - name: Build
+        run: |
+          set -x
+          cd /Users/Shared/telegram-ios
+          BUILD_NUMBER=$(( $(git rev-list --count HEAD) + $(cat build_number_offset) ))
+          python3 build-system/Make/ImportCertificates.py --path build-system/fake-codesigning/certs
+          python3 -u build-system/Make/Make.py \
+            --bazelUserRoot=/private/var/tmp/_bazel_ci \
+            --overrideXcodeVersion \
+            build \
+            --configurationPath=build-system/ci-configuration.json \
+            --codesigningInformationPath=build-system/fake-codesigning \
+            --configuration=release_arm64 \
+            --buildNumber="$BUILD_NUMBER"
+          mkdir -p "$GITHUB_WORKSPACE/out"
+          cp bazel-out/applebin_ios-ios_arm*-opt-ST-*/bin/Telegram/Telegram.ipa "$GITHUB_WORKSPACE/out/Swiftgram-Ghost.ipa"
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: Swiftgram-Ghost-ipa
+          path: out/Swiftgram-Ghost.ipa
+          retention-days: 14
diff --git a/Swiftgram/SGChatListSimpleSettingsSignal/Sources/SGChatListSimpleSettingsSignal.swift b/Swiftgram/SGChatListSimpleSettingsSignal/Sources/SGChatListSimpleSettingsSignal.swift
index c46e1702..fe67d48f 100644
--- a/Swiftgram/SGChatListSimpleSettingsSignal/Sources/SGChatListSimpleSettingsSignal.swift
+++ b/Swiftgram/SGChatListSimpleSettingsSignal/Sources/SGChatListSimpleSettingsSignal.swift
@@ -19,3 +19,24 @@ public func sgSimpleSettingsBoolSignal(_ key: SGSimpleSettings.Keys, defaultValu
     }
     return (initial |> then(changes)) |> distinctUntilChanged
 }
+
+// MARK: tontoho Mode — whether the chat list title should show the ghost status
+public func sgGhostChatListStatusSignal() -> Signal<Bool, NoError> {
+    let current: () -> Bool = {
+        return SGSimpleSettings.shared.ghostStatusInChatList && SGSimpleSettings.shared.isAnyGhostOptionOn
+    }
+    let changes = Signal<Bool, NoError> { subscriber in
+        subscriber.putNext(current())
+        let observer = NotificationCenter.default.addObserver(
+            forName: UserDefaults.didChangeNotification,
+            object: UserDefaults.standard,
+            queue: nil
+        ) { _ in
+            subscriber.putNext(current())
+        }
+        return ActionDisposable {
+            NotificationCenter.default.removeObserver(observer)
+        }
+    }
+    return changes |> distinctUntilChanged
+}
diff --git a/Swiftgram/SGSettingsUI/Sources/TontohoCustomizationController.swift b/Swiftgram/SGSettingsUI/Sources/TontohoCustomizationController.swift
new file mode 100644
index 0000000000..47ba45620e
--- /dev/null
+++ b/Swiftgram/SGSettingsUI/Sources/TontohoCustomizationController.swift
@@ -0,0 +1,128 @@
+// MARK: tontoho Mode — "Customization": how kept deleted messages look, ads, ghost status in the chat list.
+import SGItemListUI
+import SGSimpleSettings
+import SGStrings
+
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private enum CustomizationSection: Int32, SGItemListSection {
+    case personalization
+    case useful
+}
+
+private enum CustomizationToggle: String {
+    case translucent
+    case hideAds
+    case ghostStatus
+}
+
+private enum CustomizationSelector: String {
+    case mark
+    case markColor
+}
+
+private typealias CustomizationEntry = SGItemListUIEntry<CustomizationSection, CustomizationToggle, AnyHashable, CustomizationSelector, AnyHashable, AnyHashable>
+
+private func markTitle(_ mark: SGSimpleSettings.DeletedMark, _ lang: String) -> String {
+    return "\(mark.symbol)  \(i18n("Customization.Mark.\(mark.rawValue)", lang))"
+}
+
+private func colorTitle(_ color: SGSimpleSettings.DeletedMarkColor, _ lang: String) -> String {
+    return i18n("Customization.Color.\(color.rawValue)", lang)
+}
+
+private func customizationEntries(presentationData: PresentationData) -> [CustomizationEntry] {
+    let lang = presentationData.strings.baseLanguageCode
+    let s = SGSimpleSettings.shared
+    let id = SGItemListCounter()
+    var entries: [CustomizationEntry] = []
+
+    entries.append(.header(id: id.count, section: .personalization, text: i18n("Customization.Personalization.Header", lang), badge: nil))
+    entries.append(.toggle(id: id.count, section: .personalization, settingName: .translucent, value: s.deletedTranslucent, text: i18n("Customization.Translucent", lang), enabled: true))
+    entries.append(.oneFromManySelector(id: id.count, section: .personalization, settingName: .mark, text: i18n("Customization.Mark", lang), value: markTitle(s.deletedMarkEnum, lang), enabled: true))
+    entries.append(.oneFromManySelector(id: id.count, section: .personalization, settingName: .markColor, text: i18n("Customization.MarkColor", lang), value: colorTitle(s.deletedMarkColorEnum, lang), enabled: s.deletedMarkEnum.isTintable))
+    entries.append(.notice(id: id.count, section: .personalization, text: i18n("Customization.MarkColor.Notice", lang)))
+
+    entries.append(.header(id: id.count, section: .useful, text: i18n("Customization.Useful.Header", lang), badge: nil))
+    entries.append(.toggle(id: id.count, section: .useful, settingName: .hideAds, value: s.hideSponsoredMessages, text: i18n("Customization.HideAds", lang), enabled: true))
+    entries.append(.toggle(id: id.count, section: .useful, settingName: .ghostStatus, value: s.ghostStatusInChatList, text: i18n("Customization.GhostStatus", lang), enabled: true))
+    entries.append(.notice(id: id.count, section: .useful, text: i18n("Customization.GhostStatus.Notice", lang)))
+
+    return entries
+}
+
+public func sgTontohoCustomizationController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise(true, ignoreRepeated: false)
+    var presentControllerImpl: ((ViewController, ViewControllerPresentationArguments?) -> Void)?
+
+    let arguments = SGItemListArguments<CustomizationToggle, AnyHashable, CustomizationSelector, AnyHashable, AnyHashable>(
+        context: context,
+        setBoolValue: { setting, value in
+            let s = SGSimpleSettings.shared
+            switch setting {
+            case .translucent:
+                s.deletedTranslucent = value
+            case .hideAds:
+                s.hideSponsoredMessages = value
+            case .ghostStatus:
+                s.ghostStatusInChatList = value
+            }
+            refresh.set(true)
+        },
+        setOneFromManyValue: { setting in
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            let lang = presentationData.strings.baseLanguageCode
+            let s = SGSimpleSettings.shared
+            let actionSheet = ActionSheetController(presentationData: presentationData)
+            var items: [ActionSheetItem] = []
+            switch setting {
+            case .mark:
+                for mark in SGSimpleSettings.DeletedMark.allCases {
+                    let title = (s.deletedMarkEnum == mark ? "✓ " : "") + markTitle(mark, lang)
+                    items.append(ActionSheetButtonItem(title: title, color: .accent, action: { [weak actionSheet] in
+                        actionSheet?.dismissAnimated()
+                        SGSimpleSettings.shared.deletedMark = mark.rawValue
+                        refresh.set(true)
+                    }))
+                }
+            case .markColor:
+                for color in SGSimpleSettings.DeletedMarkColor.allCases {
+                    let title = (s.deletedMarkColorEnum == color ? "✓ " : "") + colorTitle(color, lang)
+                    items.append(ActionSheetButtonItem(title: title, color: .accent, action: { [weak actionSheet] in
+                        actionSheet?.dismissAnimated()
+                        SGSimpleSettings.shared.deletedMarkColor = color.rawValue
+                        refresh.set(true)
+                    }))
+                }
+            }
+            actionSheet.setItemGroups([ActionSheetItemGroup(items: items), ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])])
+            presentControllerImpl?(actionSheet, ViewControllerPresentationArguments(presentationAnimation: .modalSheet))
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(), refresh.get(), context.sharedContext.presentationData)
+    |> map { _, presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries = customizationEntries(presentationData: presentationData)
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(i18n("TontohoMode.Customization", presentationData.strings.baseLanguageCode)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentControllerImpl = { [weak controller] c, a in
+        controller?.present(c, in: .window(.root), with: a)
+    }
+    return controller
+}
