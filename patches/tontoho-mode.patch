diff --git a/submodules/TelegramCore/Sources/SyncCore/SyncCore_SGDeletedMessageAttribute.swift b/submodules/TelegramCore/Sources/SyncCore/SyncCore_SGDeletedMessageAttribute.swift
new file mode 100644
index 00000000..484ecbb5
--- /dev/null
+++ b/submodules/TelegramCore/Sources/SyncCore/SyncCore_SGDeletedMessageAttribute.swift
@@ -0,0 +1,193 @@
+// MARK: Swiftgram — keep messages that others delete.
+//
+// When the setting is on, a server deletion of a cloud message does not remove it from the local
+// database: the message is kept and marked with `SGDeletedMessageAttribute`, which the chat shows
+// next to the time. Secret chats and non-cloud namespaces (scheduled, quick replies, ephemeral)
+// are deleted as usual, and so is everything when the setting is off.
+
+import Foundation
+import Postbox
+import SGSimpleSettings
+
+public final class SGDeletedMessageAttribute: MessageAttribute {
+    /// When this device learned that the message was deleted.
+    public let date: Int32
+
+    public init(date: Int32) {
+        self.date = date
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+    }
+}
+
+public extension Message {
+    var sgIsDeleted: Bool {
+        for attribute in self.attributes {
+            if attribute is SGDeletedMessageAttribute {
+                return true
+            }
+        }
+        return false
+    }
+}
+
+func sgMessageIsKeptDeleted(transaction: Transaction, id: MessageId) -> Bool {
+    guard let message = transaction.getMessage(id) else {
+        return false
+    }
+    return message.sgIsDeleted
+}
+
+/// Whether a server deletion of this message should keep it instead (and mark it) right now.
+private func sgShouldKeepDeleted(transaction: Transaction, id: MessageId) -> Bool {
+    if !SGSimpleSettings.shared.keepDeletedMessages {
+        return false
+    }
+    if id.namespace != Namespaces.Message.Cloud {
+        return false
+    }
+    if id.peerId.namespace == Namespaces.Peer.SecretChat {
+        return false
+    }
+    if !SGSimpleSettings.shared.keepDeletedInBots, let user = transaction.getPeer(id.peerId) as? TelegramUser, user.botInfo != nil {
+        return false
+    }
+    return transaction.getMessage(id) != nil
+}
+
+private func sgMarkDeleted(transaction: Transaction, id: MessageId) {
+    let timestamp = Int32(CFAbsoluteTimeGetCurrent() + NSTimeIntervalSince1970)
+    transaction.updateMessage(id, update: { currentMessage in
+        if currentMessage.sgIsDeleted {
+            return .skip
+        }
+        let storeForwardInfo = currentMessage.forwardInfo.flatMap(StoreMessageForwardInfo.init)
+        var attributes = currentMessage.attributes
+        attributes.append(SGDeletedMessageAttribute(date: timestamp))
+        return .update(StoreMessage(id: currentMessage.id, customStableId: nil, globallyUniqueId: currentMessage.globallyUniqueId, groupingKey: currentMessage.groupingKey, threadId: currentMessage.threadId, timestamp: currentMessage.timestamp, flags: StoreMessageFlags(currentMessage.flags), tags: currentMessage.tags, globalTags: currentMessage.globalTags, localTags: currentMessage.localTags, forwardInfo: storeForwardInfo, authorId: currentMessage.author?.id, text: currentMessage.text, attributes: attributes, media: currentMessage.media))
+    })
+}
+
+/// Marks the messages that are to be kept and returns the ids that still have to be deleted.
+func sgKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    if !SGSimpleSettings.shared.keepDeletedMessages {
+        return ids
+    }
+    var remaining: [MessageId] = []
+    for id in ids {
+        if sgShouldKeepDeleted(transaction: transaction, id: id) {
+            sgMarkDeleted(transaction: transaction, id: id)
+        } else {
+            remaining.append(id)
+        }
+    }
+    return remaining
+}
+
+/// The same for deletions that the server sends by global id (private chats and basic groups).
+func sgKeepDeletedMessages(transaction: Transaction, globalIds: [Int32]) -> [Int32] {
+    if !SGSimpleSettings.shared.keepDeletedMessages {
+        return globalIds
+    }
+    var remaining: [Int32] = []
+    for globalId in globalIds {
+        if let id = transaction.messageIdsForGlobalIds([globalId]).first, sgShouldKeepDeleted(transaction: transaction, id: id) {
+            sgMarkDeleted(transaction: transaction, id: id)
+        } else {
+            remaining.append(globalId)
+        }
+    }
+    return remaining
+}
+
+// MARK: Swiftgram — edit history.
+//
+// When the setting is on, each server edit that changes a message's text stores the text it had
+// before, with the time that version was current from. The versions are shown from the message's
+// context menu ("Edit history").
+
+public final class SGEditHistoryMessageAttribute: MessageAttribute {
+    public struct Version: Equatable {
+        public let text: String
+        public let date: Int32
+
+        public init(text: String, date: Int32) {
+            self.text = text
+            self.date = date
+        }
+    }
+
+    /// Oldest first; the current text is not included.
+    public let versions: [Version]
+
+    public init(versions: [Version]) {
+        self.versions = versions
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let texts = decoder.decodeStringArrayForKey("t")
+        let dates = decoder.decodeInt32ArrayForKey("d")
+        var versions: [Version] = []
+        for i in 0 ..< min(texts.count, dates.count) {
+            versions.append(Version(text: texts[i], date: dates[i]))
+        }
+        self.versions = versions
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeStringArray(self.versions.map(\.text), forKey: "t")
+        encoder.encodeInt32Array(self.versions.map(\.date), forKey: "d")
+    }
+}
+
+public extension Message {
+    var sgEditHistory: [SGEditHistoryMessageAttribute.Version] {
+        for attribute in self.attributes {
+            if let attribute = attribute as? SGEditHistoryMessageAttribute {
+                return attribute.versions
+            }
+        }
+        return []
+    }
+}
+
+private let sgEditHistoryLimit = 50
+
+/// Called for a server copy that replaces a stored message: records the previous text when it changed.
+func sgRecordEditHistory(previous previousMessage: Message, attributes: inout [MessageAttribute], updatedText: String) {
+    if !SGSimpleSettings.shared.keepEditHistory {
+        return
+    }
+    if previousMessage.text == updatedText || previousMessage.text.isEmpty {
+        return
+    }
+    var versions = previousMessage.sgEditHistory
+    let since = previousMessage.editedTime ?? previousMessage.timestamp
+    versions.append(SGEditHistoryMessageAttribute.Version(text: previousMessage.text, date: since))
+    if versions.count > sgEditHistoryLimit {
+        versions.removeFirst(versions.count - sgEditHistoryLimit)
+    }
+    attributes.removeAll(where: { $0 is SGEditHistoryMessageAttribute })
+    attributes.append(SGEditHistoryMessageAttribute(versions: versions))
+}
+
+/// Server copies never carry these local attributes: keep them across every update of a stored message.
+func sgMergeMessageAttributes(previous: [MessageAttribute], updated: inout [MessageAttribute]) {
+    for attribute in previous {
+        if attribute is SGDeletedMessageAttribute {
+            if !updated.contains(where: { $0 is SGDeletedMessageAttribute }) {
+                updated.append(attribute)
+            }
+        } else if attribute is SGEditHistoryMessageAttribute {
+            if !updated.contains(where: { $0 is SGEditHistoryMessageAttribute }) {
+                updated.append(attribute)
+            }
+        }
+    }
+}
